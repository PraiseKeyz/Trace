// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum OpportunityApplicationStatus {
  pending
  accepted
  rejected
}

model User {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name           String?  @db.VarChar(255)
  phone               String   @unique @db.VarChar(20)
  email               String?  @unique @db.VarChar(255)
  password_hash       String   @db.Text
  role                Role[]   @default([user])
  state               String?  @db.VarChar(100)
  city                String?  @db.VarChar(100)
  latitude            Decimal? @db.Decimal(9, 6)
  longitude           Decimal? @db.Decimal(9, 6)
  squad_customer_id   String?  @db.VarChar(255)
  virtual_account_no  String?  @db.VarChar(50)
  is_phone_verified   Boolean  @default(false)
  languages           String[] @default([])
  preferred_language  String?  @default("en") @db.VarChar(20)
  data_sharing_consent Boolean @default(false)
  otp_code            String?  @db.Text
  otp_expires_at      DateTime?
  persona             String?  @db.VarChar(20)
  gender              String?  @db.VarChar(10)
  dob                 String?  @db.VarChar(10)
  onboarding_complete Boolean? @default(false)
  created_at          DateTime @default(now()) @db.Timestamp()
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamp()

  economic_profile    EconomicProfile?
  transactions        Transaction[] @relation("UserTransactions")
  counterparty_tx     Transaction[] @relation("CounterpartyTransactions")
  opportunities       Opportunity[] @relation("PostedOpportunities")
  selected_for        Opportunity[] @relation("SelectedApplicant")
  applications        OpportunityApplication[]
  given_vouches       Vouch[] @relation("GivenVouches")
  received_vouches    Vouch[] @relation("ReceivedVouches")

  @@map("users")
}

model EconomicProfile {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String    @unique @db.Uuid
  identity_score           Int       @default(0)
  transaction_score        Decimal   @default(0) @db.Decimal(5, 2)
  activity_score           Decimal   @default(0) @db.Decimal(5, 2)
  vouch_score              Decimal   @default(0) @db.Decimal(5, 2)
  profile_completeness     Decimal   @default(0) @db.Decimal(5, 2)
  skills                   String[]  @default([])
  trade_category           String?   @db.VarChar(100)
  years_active             Int?
  is_profile_verified      Boolean   @default(false)
  total_transaction_volume Decimal   @default(0) @db.Decimal(15, 2)
  total_transaction_count  Int       @default(0)
  avg_monthly_volume       Decimal   @default(0) @db.Decimal(15, 2)
  last_transaction_at      DateTime?
  vouch_count              Int       @default(0)
  verified_vouch_count     Int       @default(0)
  risk_tier                String    @default("high") @db.VarChar(10)
  is_finance_eligible      Boolean   @default(false)
  max_recommended_loan     Decimal   @default(0) @db.Decimal(15, 2)
  last_active              DateTime?
  updated_at               DateTime  @default(now()) @updatedAt @db.Timestamp()

  user User @relation(fields: [user_id], references: [id])

  @@map("economic_profiles")
}

model Transaction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @db.Uuid
  counterparty_id String?  @db.Uuid
  squad_reference String?  @unique @db.VarChar(255)
  type            String   @db.VarChar(30)
  category        String?  @db.VarChar(50)
  amount          Decimal  @db.Decimal(15, 2)
  currency        String   @default("NGN") @db.VarChar(5)
  status          String   @default("pending") @db.VarChar(20)
  metadata        Json?
  created_at      DateTime @default(now()) @db.Timestamp()

  user         User  @relation("UserTransactions", fields: [user_id], references: [id])
  counterparty User? @relation("CounterpartyTransactions", fields: [counterparty_id], references: [id])

  @@index([user_id])
  @@index([created_at])
  @@map("transactions")
}

model Opportunity {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  posted_by          String   @db.Uuid
  title              String   @db.VarChar(255)
  description        String?  @db.Text
  type               String   @db.VarChar(30)
  skills_required    String[] @default([])
  languages_required String[] @default([])
  state              String?  @db.VarChar(100)
  city               String?  @db.VarChar(100)
  latitude           Decimal? @db.Decimal(9, 6)
  longitude          Decimal? @db.Decimal(9, 6)
  is_remote          Boolean  @default(false)
  pay_min            Decimal? @db.Decimal(15, 2)
  pay_max            Decimal? @db.Decimal(15, 2)
  currency           String   @default("NGN") @db.VarChar(5)
  status             String    @default("open") @db.VarChar(20)
  selected_applicant String?   @db.Uuid
  payment_method     String    @default("squad") @db.VarChar(20)
  escrow_reference   String?   @db.VarChar(255)
  escrow_amount      Decimal?  @db.Decimal(15, 2)
  funds_locked_at    DateTime?
  worker_done_at     DateTime?
  auto_release_at    DateTime?
  created_at         DateTime  @default(now()) @db.Timestamp()
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamp()

  poster    User                     @relation("PostedOpportunities", fields: [posted_by], references: [id])
  selected  User?                    @relation("SelectedApplicant", fields: [selected_applicant], references: [id])
  applications OpportunityApplication[]

  @@map("opportunities")
}

model OpportunityApplication {
  id             String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunity_id String                       @db.Uuid
  applicant_id   String                       @db.Uuid
  status         OpportunityApplicationStatus @default(pending)
  match_score    Decimal?                     @db.Decimal(5, 2)
  cover_note     String?                      @db.Text
  applied_at     DateTime                     @default(now()) @db.Timestamp()

  opportunity Opportunity @relation(fields: [opportunity_id], references: [id])
  applicant   User        @relation(fields: [applicant_id], references: [id])

  @@unique([opportunity_id, applicant_id])
  @@map("opportunity_applications")
}

model Vouch {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucher_id   String   @db.Uuid
  recipient_id String   @db.Uuid
  message      String?  @db.Text
  weight       Decimal  @default(1) @db.Decimal(4, 2)
  created_at   DateTime @default(now()) @db.Timestamp()

  voucher   User @relation("GivenVouches", fields: [voucher_id], references: [id])
  recipient User @relation("ReceivedVouches", fields: [recipient_id], references: [id])

  @@unique([voucher_id, recipient_id])
  @@map("vouches")
}
