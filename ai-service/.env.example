# AI Service Configuration

# ── Server ───────────────────────────────────────────────────
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
GRPC_SERVICE_PORT=50051
GRPC_SERVICE_HOST=[::]

# ── Database (PostgreSQL — shared with Node.js backend) ──────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/trace_db

# ── Redis Cache ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ── Backend Communication ────────────────────────────────────
BACKEND_URL=http://localhost:3000

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── ML / NLP Configuration ──────────────────────────────────
# AfroXLM-R: transformer pre-trained on 17 African languages
EMBEDDING_MODEL_NAME=Davlan/afro-xlmr-large
MODEL_DEVICE=cpu

# ── Score Weights (Identity Engine — Section 9) ──────────────
WEIGHT_TRANSACTION_HISTORY=0.40
WEIGHT_PLATFORM_ACTIVITY=0.20
WEIGHT_COMMUNITY_VOUCHING=0.25
WEIGHT_PROFILE_COMPLETENESS=0.15

# ── Match Weights (Matching Engine — Section 9) ──────────────
WEIGHT_SKILL_OVERLAP=0.40
WEIGHT_PROXIMITY=0.25
WEIGHT_LANGUAGE_MATCH=0.15
WEIGHT_HISTORICAL_SUCCESS=0.20

# ── Retraining ───────────────────────────────────────────────
RETRAIN_CRON_ENABLED=false
